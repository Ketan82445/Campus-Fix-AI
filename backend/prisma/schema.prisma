generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TECHNICIAN
  ADMIN
}

enum Category {
  IT_NETWORK
  ELECTRICAL
  PLUMBING
  CLEANING
  HOSTEL
  CLASSROOM
  LABORATORY
  LIBRARY
  SECURITY
  TRANSPORT
  CANTEEN
  INFRASTRUCTURE
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  DRAFT
  SUBMITTED
  AI_ANALYZING
  AI_REVIEW_REQUIRED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REOPENED
  CLOSED
  REJECTED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(STUDENT)
  phone        String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdComplaints    Complaint[]         @relation("ComplaintCreator")
  assignedComplaints   Complaint[]         @relation("AssignedTechnician")
  assignments          Assignment[]        @relation("TechnicianAssignments")
  assignedByMe         Assignment[]        @relation("AssignmentCreator")
  statusHistory        StatusHistory[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  comments             ComplaintComment[]
  upvotes              ComplaintUpvote[]
  followedComplaints   ComplaintFollower[]
  feedbacks            ComplaintFeedback[]
  maintenances         AssetMaintenance[]
  assignedWorkOrders   WorkOrder[]         @relation("WorkOrderTechnician")
  supervisedWorkOrders WorkOrder[]         @relation("WorkOrderSupervisor")
  uploadedFiles        FileAttachment[]

  @@index([email])
  @@index([role])
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  complaints Complaint[]
  assets     Asset[]
  WorkOrder  WorkOrder[]
}

model Complaint {
  id              String   @id @default(uuid())
  complaintNumber String   @unique
  title           String
  description     String
  category        Category @default(OTHER)
  priority        Priority @default(MEDIUM)
  location        String
  status          Status   @default(SUBMITTED)
  aiConfidence    Float?

  createdById String
  createdBy   User   @relation("ComplaintCreator", fields: [createdById], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assignedTechnicianId String?
  assignedTechnician   User?   @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  building String?
  floor    String?
  room     String?
  language String? @default("en")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  duplicateOfId String?
  duplicateOf   Complaint?  @relation("ComplaintDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Complaint[] @relation("ComplaintDuplicates")

  responseDeadline   DateTime?
  resolutionDeadline DateTime?
  respondedAt        DateTime?
  slaBreached        Boolean   @default(false)
  escalationLevel    Int       @default(0)
  escalatedAt        DateTime?

  assignments   Assignment[]
  statusHistory StatusHistory[]
  aiPredictions AIPrediction[]
  comments      ComplaintComment[]
  attachments   FileAttachment[]
  upvotes       ComplaintUpvote[]
  feedback      ComplaintFeedback?
  workOrder     WorkOrder?
  followers     ComplaintFollower[]

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([departmentId])
  @@index([createdById])
  @@index([assignedTechnicianId])
  @@index([duplicateOfId])
  @@index([slaBreached])
  @@index([resolutionDeadline])
  @@index([createdAt])
  @@index([assetId])
}

model ComplaintUpvote {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([complaintId, userId])
  @@index([complaintId])
  @@index([userId])
}

model FileAttachment {
  id       String @id @default(uuid())
  fileUrl  String
  fileName String
  fileSize Int
  mimeType String

  uploaderId String?
  uploader   User?   @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  category String? @default("GENERAL") // e.g., BEFORE_PHOTO, AFTER_PHOTO, INVOICE, DOCUMENT

  createdAt DateTime @default(now())

  @@index([complaintId])
  @@index([workOrderId])
  @@index([assetId])
}

model Assignment {
  id           String           @id @default(uuid())
  complaintId  String
  complaint    Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User             @relation("TechnicianAssignments", fields: [technicianId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?            @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  status       AssignmentStatus @default(ASSIGNED)
  notes        String?
  assignedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([complaintId])
  @@index([technicianId])
}

model StatusHistory {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  oldStatus   Status?
  newStatus   Status
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

model AIPrediction {
  id                   String    @id @default(uuid())
  complaintId          String
  complaint            Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  predictedCategory    Category
  predictedPriority    Priority
  predictedDepartment  String?
  confidence           Float
  modelVersion         String    @default("campusfix-v1")
  predictionIndicators String? // JSON string of keywords/indicators
  status               String    @default("SUCCESS") // SUCCESS, FAILED, LOW_CONFIDENCE
  createdAt            DateTime  @default(now())

  @@index([complaintId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // COMPLAINT_CREATED, COMPLAINT_ASSIGNED, STATUS_CHANGED, RESOLVED, REOPENED, AI_REVIEW
  read      Boolean  @default(false)
  entityId  String? // complaintId or assignmentId
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // LOGIN, COMPLAINT_CREATED, ASSIGNMENT_CREATED, STATUS_CHANGED, AI_REVIEWED, etc.
  entityType String // COMPLAINT, ASSIGNMENT, WORK_ORDER, USER, DEPARTMENT
  entityId   String?
  metadata   String? // JSON formatted details
  ipAddress  String? // Track network origin
  userAgent  String? // Track browser/device
  timestamp  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([timestamp])
}

enum WorkOrderStatus {
  CREATED
  ASSIGNED
  SCHEDULED
  ACKNOWLEDGED
  IN_PROGRESS
  WAITING_FOR_PARTS
  WAITING_FOR_APPROVAL
  RESOLVED
  VERIFIED
  CLOSED
  CANCELLED
}

model WorkOrder {
  id              String @id @default(uuid())
  workOrderNumber String @unique

  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  technicianId String?
  technician   User?   @relation("WorkOrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  supervisorId String?
  supervisor   User?   @relation("WorkOrderSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  priority Priority        @default(MEDIUM)
  status   WorkOrderStatus @default(CREATED)

  scheduledDate DateTime?
  startedDate   DateTime?
  completedDate DateTime?

  estimatedHours Float?
  actualHours    Float?

  notes           String?
  resolutionNotes String?
  checklist       String? // JSON structured checklist
  laborInfo       String? // JSON structured labor tracking

  studentConfirmed   Boolean @default(false)
  supervisorApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments FileAttachment[]
  parts       WorkOrderPart[]

  @@index([status])
  @@index([technicianId])
}

model WorkOrderPart {
  id           String        @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryId  String
  inventory    InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  quantityUsed Int
  createdAt    DateTime      @default(now())

  @@index([workOrderId])
}

model ComplaintComment {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comment     String
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

model ComplaintFollower {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([complaintId, studentId])
  @@index([complaintId])
  @@index([studentId])
}

model SLAConfig {
  id              String   @id @default(uuid())
  priority        Priority @unique
  responseHours   Int
  resolutionHours Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ComplaintFeedback {
  id          String    @id @default(uuid())
  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())

  @@index([studentId])
  @@index([rating])
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

model Incident {
  id          String           @id @default(uuid())
  title       String
  description String
  category    Category
  severity    IncidentSeverity @default(MAJOR)
  status      Status           @default(IN_PROGRESS)
  location    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  complaints Complaint[]

  @@index([status])
  @@index([category])
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  BROKEN
  RETIRED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Asset {
  id              String      @id @default(uuid())
  assetCode       String      @unique
  qrCode          String?     @unique
  name            String
  type            String
  manufacturer    String?
  model           String?
  serialNumber    String?
  location        String
  building        String?
  floor           String?
  room            String?
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  purchaseDate    DateTime?
  warrantyExpires DateTime?
  status          AssetStatus @default(ACTIVE)
  cost            Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  maintenances   AssetMaintenance[]
  complaints     Complaint[]
  FileAttachment FileAttachment[]

  @@index([assetCode])
  @@index([status])
  @@index([location])
  @@index([departmentId])
}

model AssetMaintenance {
  id            String            @id @default(uuid())
  assetId       String
  asset         Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          MaintenanceType
  status        MaintenanceStatus @default(SCHEDULED)
  scheduledDate DateTime?
  completedDate DateTime?
  technicianId  String?
  technician    User?             @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  cost          Float?            @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  partsUsed MaintenancePart[]

  @@index([assetId])
  @@index([technicianId])
  @@index([status])
  @@index([type])
}

model InventoryItem {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  description   String?
  quantity      Int      @default(0)
  minStockLevel Int      @default(5)
  cost          Float?
  supplier      String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usedIn        MaintenancePart[]
  WorkOrderPart WorkOrderPart[]

  @@index([sku])
}

model MaintenancePart {
  id              String           @id @default(uuid())
  maintenanceId   String
  maintenance     AssetMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  quantity        Int
  costAtUse       Float?
  createdAt       DateTime         @default(now())

  @@index([maintenanceId])
  @@index([inventoryItemId])
}
